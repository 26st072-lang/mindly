# Local testing only. Copy this file to .dev.vars, or use start-extension-test.cmd.
# Put a valid Gemini key inside the quotation marks to test real AI responses.
# Keep .dev.vars private. It is ignored by Git and blocked by the local web server.
GEMINI_API_KEY=""
# Evidence Grounding accepts only free-search 2.5 models; never enable paid fallback.
EVIDENCE_GEMINI_MODEL="gemini-2.5-flash"
EVIDENCE_USER_DAILY_LIMIT="5"
EVIDENCE_SITE_DAILY_LIMIT="20"
